{
  "name": "scramble-type",
  "version": "0.1.0",
  "description": "Zero-dependency scramble/decode typewriter text effect for React, Vue, Web Components and plain HTML.",
  "keywords": [
    "typewriter",
    "text-effect",
    "scramble",
    "decode",
    "glitch",
    "hacker",
    "terminal",
    "react",
    "vue",
    "web-component",
    "animation"
  ],
  "license": "MIT",
  "author": "ScrambleType Authors",
  "homepage": "https://github.com/abitfox/scramble-type#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abitfox/scramble-type.git"
  },
  "bugs": "https://github.com/abitfox/scramble-type/issues",
  "type": "module",
  "sideEffects": [
    "./dist/wc/index.js",
    "./dist/wc/index.cjs",
    "./dist/wc/global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./wc": {
      "types": "./dist/wc.d.ts",
      "import": "./dist/wc.js",
      "require": "./dist/wc.cjs"
    },
    "./wc/global": "./dist/wc/global.js",
    "./sound": {
      "types": "./dist/sound.d.ts",
      "import": "./dist/sound.js",
      "require": "./dist/sound.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "dev": "vite",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "size": "size-limit",
    "release": "changeset publish",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": "^3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.11",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "size-limit": [
    {
      "name": "react entry",
      "path": "dist/index.js",
      "limit": "2.5 KB"
    },
    {
      "name": "core engine",
      "path": "dist/core.js",
      "limit": "1.5 KB"
    },
    {
      "name": "wc global (iife)",
      "path": "dist/wc/global.js",
      "limit": "2.5 KB"
    }
  ]
}
